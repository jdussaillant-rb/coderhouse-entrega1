# Copia este archivo a .env y completa tus claves. Nunca subas .env al repositorio.
OPENAI_API_KEY=sk-tu-clave-de-openai
ANTHROPIC_API_KEY=sk-ant-tu-clave-de-anthropic

# Proveedor por defecto (openai | anthropic). Si se deja comentado, main.py usa todos los
# proveedores que tengan clave; para AsyncLLMManager.from_env() el defecto es openai.
# LLM_PROVIDER=openai
# Modelos (opcional; por defecto gpt-5-mini y claude-opus-5-5)
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-opus-5-5

# Parámetros opcionales
# LLM_TEMPERATURE=1.0   # 0 a 2; Anthropic la ignora
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
